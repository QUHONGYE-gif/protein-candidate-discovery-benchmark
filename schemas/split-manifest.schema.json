{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QUHONGYE-gif/protein-candidate-discovery-benchmark/schemas/split-manifest.schema.json",
  "title": "SplitManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "split_id",
    "protocol_version",
    "processing_manifest_sha256",
    "membership_file",
    "partitions",
    "grouping_unit",
    "leakage_controls",
    "held_out_partitions"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "split_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "protocol_version": { "type": "string", "minLength": 1 },
    "processing_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "membership_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_key", "sha256", "size_bytes"],
      "properties": {
        "object_key": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
      "uniqueItems": true
    },
    "grouping_unit": { "type": "string", "minLength": 1 },
    "leakage_controls": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "held_out_partitions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
