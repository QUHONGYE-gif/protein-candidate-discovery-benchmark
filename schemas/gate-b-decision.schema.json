{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QUHONGYE-gif/protein-candidate-discovery-benchmark/schemas/gate-b-decision.schema.json",
  "title": "Gate B Milestone Evidence Review",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "github_comment_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "repository", "comment_id", "node_id", "actor", "updated_at", "body", "body_sha256", "decision_digest"],
      "properties": {
        "schema_version": { "const": "pcdb-github-comment-attestation-v1" },
        "repository": { "const": "QUHONGYE-gif/protein-candidate-discovery-benchmark" },
        "comment_id": { "type": "integer", "minimum": 1 },
        "node_id": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "pattern": "^github:[A-Za-z0-9._-]+$" },
        "updated_at": { "type": "string", "format": "date-time" },
        "body": { "type": "string", "minLength": 1 },
        "body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "decision_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "required": ["schema_version", "record_status", "decision_id", "contract_id", "contract_version", "contract_digest", "evidence_digest", "reviewers", "explicit_boundary_approvals", "verdict", "decided_at", "rationale", "claim_boundary"],
  "properties": {
    "schema_version": { "const": "pcdb-gate-b-decision-v1" },
    "record_status": { "enum": ["example", "final"] },
    "decision_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "contract_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "contract_version": { "type": "integer", "minimum": 1 },
    "contract_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority", "relation", "attestation"],
        "properties": {
          "authority": { "type": "string", "minLength": 1 },
          "relation": { "enum": ["not_summary_preparer", "summary_preparer", "internal_non_independent_review"] },
          "attestation": { "$ref": "#/$defs/github_comment_attestation" }
        }
      }
    },
    "explicit_boundary_approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority", "boundaries"],
        "properties": {
          "authority": { "type": "string", "minLength": 1 },
          "boundaries": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["held_out_boundary", "primary_endpoint", "dataset_inclusion", "cost_semantics"] }
          }
        }
      }
    },
    "verdict": { "enum": ["accept", "reject", "inconclusive"] },
    "decided_at": { "type": "string", "format": "date-time" },
    "rationale": { "type": "string", "minLength": 1 },
    "claim_boundary": { "type": "string", "minLength": 1 }
  }
}
