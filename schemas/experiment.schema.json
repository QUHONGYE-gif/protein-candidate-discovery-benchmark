{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QUHONGYE-gif/protein-candidate-discovery-benchmark/schemas/experiment.schema.json",
  "title": "ExperimentConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "phase",
    "dataset_manifest_sha256",
    "split_sha256",
    "models",
    "acquisitions",
    "seeds",
    "initial_sample_sizes",
    "batch_sizes",
    "budgets"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "experiment_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "phase": { "enum": ["smoke", "development", "pilot", "frozen"] },
    "dataset_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "split_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "models": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "acquisitions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "seeds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
    "initial_sample_sizes": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
    "batch_sizes": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
    "budgets": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
    "held_out_authorized": { "type": "boolean", "default": false }
  }
}
