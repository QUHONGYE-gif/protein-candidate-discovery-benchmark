{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QUHONGYE-gif/protein-candidate-discovery-benchmark/schemas/m2-feature-config-v1.schema.json",
  "title": "M2FeatureConfigV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_config_id", "derivations"],
  "properties": {
    "schema_version": { "const": "m2-feature-config-v1" },
    "feature_config_id": { "$ref": "#/$defs/identifier" },
    "derivations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/derivation" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "shape": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "derivation_id",
        "derivation_version",
        "parameters"
      ],
      "properties": {
        "feature_id": { "$ref": "#/$defs/identifier" },
        "derivation_id": { "$ref": "#/$defs/identifier" },
        "derivation_version": { "$ref": "#/$defs/identifier" },
        "parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/parameter" }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dtype", "shape", "values"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "dtype": {
          "enum": ["bool", "int32", "int64", "float32", "float64", "utf8"]
        },
        "shape": { "$ref": "#/$defs/shape" },
        "values": { "type": "array" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "dtype": { "const": "bool" } },
            "required": ["dtype"]
          },
          "then": {
            "properties": {
              "values": { "items": { "type": "boolean" } }
            }
          }
        },
        {
          "if": {
            "properties": { "dtype": { "enum": ["int32", "int64"] } },
            "required": ["dtype"]
          },
          "then": {
            "properties": {
              "values": {
                "items": {
                  "type": "string",
                  "pattern": "^(0|-?[1-9][0-9]*)$"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "dtype": { "const": "float32" } },
            "required": ["dtype"]
          },
          "then": {
            "properties": {
              "values": {
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}$"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "dtype": { "const": "float64" } },
            "required": ["dtype"]
          },
          "then": {
            "properties": {
              "values": {
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "dtype": { "const": "utf8" } },
            "required": ["dtype"]
          },
          "then": {
            "properties": {
              "values": { "items": { "type": "string" } }
            }
          }
        }
      ]
    }
  }
}
