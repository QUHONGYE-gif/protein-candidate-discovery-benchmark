{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QUHONGYE-gif/protein-candidate-discovery-benchmark/schemas/dataset-manifest.schema.json",
  "title": "DatasetManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "task_id",
    "source_url",
    "doi",
    "license",
    "downloaded_at",
    "raw_files",
    "known_limitations"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "dataset_id": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "doi": { "type": "string", "pattern": "^10\\.[0-9]{4,9}/[^\\s]+$" },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "License applying to the task-level raw files represented by this manifest."
    },
    "downloaded_at": { "type": "string", "format": "date-time" },
    "raw_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_key", "sha256", "size_bytes"],
        "properties": {
          "object_key": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
