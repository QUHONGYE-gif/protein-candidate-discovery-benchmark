{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QUHONGYE-gif/protein-candidate-discovery-benchmark/schemas/dataset-manifest.schema.json",
  "title": "DatasetManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "task_id",
    "source_url",
    "license",
    "raw_files",
    "candidate_id_field",
    "label_field",
    "label_direction"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "dataset_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "license": { "type": "string", "minLength": 1 },
    "raw_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_key", "sha256", "size_bytes"],
        "properties": {
          "object_key": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "candidate_id_field": { "type": "string", "minLength": 1 },
    "label_field": { "type": "string", "minLength": 1 },
    "label_direction": { "enum": ["higher_is_better", "lower_is_better"] },
    "notes": { "type": "string" }
  }
}
