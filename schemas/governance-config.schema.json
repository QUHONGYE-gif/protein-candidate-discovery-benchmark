{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QUHONGYE-gif/protein-candidate-discovery-benchmark/schemas/governance-config.schema.json",
  "title": "Governance v2 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "governance_version", "governance_repository", "repository_workflow", "scientific_authorities", "server", "archive"],
  "properties": {
    "schema_version": { "const": "pcdb-governance-config-v2" },
    "governance_version": { "const": "2" },
    "governance_repository": { "const": "QUHONGYE-gif/protein-candidate-discovery-benchmark" },
    "repository_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major_semantic", "maintenance_batch", "tracking_authority", "tracking_examples", "cross_links", "tracking_ledger", "forbidden_tracking_files", "status"],
      "properties": {
        "major_semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["categories", "semantic_boundaries"],
          "properties": {
            "categories": {
              "const": ["scientific_protocol", "dataset_or_split", "metric", "cost_model", "architecture", "major_runner", "storage_policy", "governance", "release"]
            },
            "semantic_boundaries": {
              "const": ["scientific_semantics", "data_identity", "execution_boundary", "storage_responsibility", "public_interface"]
            }
          }
        },
        "maintenance_batch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["categories", "logical_change_limit", "flush_on_issue_or_milestone_closeout", "flush_when_required_by_next_experiment"],
          "properties": {
            "categories": {
              "const": ["tests", "docs", "logging", "small_bugs", "minor_refactors", "plots", "cli_polish"]
            },
            "logical_change_limit": { "const": 10 },
            "flush_on_issue_or_milestone_closeout": { "const": true },
            "flush_when_required_by_next_experiment": { "const": true }
          }
        },
        "tracking_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "common_required_fields", "authority_required_fields", "multica_object_required_fields", "selection_required_for"],
          "properties": {
            "allowed": { "const": ["github_issue", "multica"] },
            "common_required_fields": { "const": ["authority", "authorization_and_acceptance"] },
            "authority_required_fields": {
              "type": "object",
              "additionalProperties": false,
              "required": ["github_issue", "multica"],
              "properties": {
                "github_issue": { "const": ["repository", "issue_number", "url"] },
                "multica": { "const": ["workspace_id", "objects"] }
              }
            },
            "multica_object_required_fields": { "const": ["object_id", "key", "url"] },
            "selection_required_for": {
              "const": [
                "Major / semantic change",
                "Independent value, acceptance criteria, risk, or authorization boundary",
                "Cross-milestone, multi-PR, multi-owner, or external coordination",
                "Data, held-out, permission, cost, privacy, security, release, or external-config risk",
                "No suitable parent Issue"
              ]
            }
          }
        },
        "tracking_examples": {
          "type": "object",
          "additionalProperties": false,
          "required": ["github_issue", "multica"],
          "properties": {
            "github_issue": {
              "type": "object",
              "additionalProperties": false,
              "required": ["authority", "authorization_and_acceptance", "repository", "issue_number", "url"],
              "properties": {
                "authority": { "const": "github_issue" },
                "authorization_and_acceptance": { "const": "Named owner authorizes scope and accepts completion" },
                "repository": { "const": "OWNER/REPO" },
                "issue_number": { "const": 123 },
                "url": { "const": "https://github.com/OWNER/REPO/issues/123" }
              }
            },
            "multica": {
              "type": "object",
              "additionalProperties": false,
              "required": ["authority", "authorization_and_acceptance", "workspace_id", "objects"],
              "properties": {
                "authority": { "const": "multica" },
                "authorization_and_acceptance": { "const": "Workspace member authorizes scope and marks the issue done after review" },
                "workspace_id": { "const": "00000000-0000-4000-8000-000000000000" },
                "objects": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["object_id", "key", "url"],
                    "properties": {
                      "object_id": { "const": "00000000-0000-7000-8000-000000000123" },
                      "key": { "const": "MIRA-123" },
                      "url": { "const": "https://MULTICA-EXAMPLE/issues/MIRA-123" }
                    }
                  }
                }
              }
            }
          }
        },
        "cross_links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mapping", "required_only_when", "github_authority_multica_title", "github_authority_multica_source", "github_authority_backlink"],
          "properties": {
            "mapping": { "const": "many_to_one" },
            "required_only_when": { "const": "github_issue" },
            "github_authority_multica_title": { "const": "[GH#123] Improve repository workflow checks" },
            "github_authority_multica_source": { "const": "Source of truth: https://github.com/OWNER/REPO/issues/123" },
            "github_authority_backlink": { "const": "Execution tracked in Multica: https://MULTICA-EXAMPLE/issues/MIRA-123" }
          }
        },
        "tracking_ledger": { "const": "git_and_authority_record" },
        "forbidden_tracking_files": {
          "const": ["maintenance-batch-ledger.yaml", "MulticaGithubLinkRegistry", "reviewer-registry.schema.json"]
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["update_events", "ignored_events"],
          "properties": {
            "update_events": {
              "const": ["gate_a_scientific_transition", "gate_b_terminal", "milestone_closeout"]
            },
            "ignored_events": {
              "const": ["ordinary_pr", "ci", "run", "retry", "log", "plot", "maintenance_batch", "engineering_only_progress"]
            }
          }
        }
      }
    },
    "scientific_authorities": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handle", "display_name", "server_user"],
        "properties": {
          "handle": { "type": "string", "pattern": "^github:[A-Za-z0-9._-]+$" },
          "display_name": { "type": "string", "minLength": 1 },
          "server_user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]*$" }
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "subdirectories", "project_group", "service_accounts", "writers", "capacity", "backup"],
      "properties": {
        "root": { "const": "/srv/pcdb" },
        "subdirectories": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" }
        },
        "project_group": { "const": "pcdb" },
        "service_accounts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "writers": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(github|git|service):[A-Za-z0-9._-]+$" }
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_fraction", "hard_cap_fraction"],
          "properties": {
            "target_fraction": { "const": 0.5 },
            "hard_cap_fraction": { "const": 0.7 }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["public_raw", "recomputable_processed", "release_candidates", "high_cost_trajectories_rpo_hours"],
          "properties": {
            "public_raw": { "const": "source_url_and_sha256_redownloadable" },
            "recomputable_processed": { "const": "recompute_allowed" },
            "release_candidates": { "const": "daily_snapshot_or_rsync" },
            "high_cost_trajectories_rpo_hours": { "const": 24 }
          }
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "allowed_terminal_verdicts", "excluded_attempt_classes", "retention"],
      "properties": {
        "prefix": { "const": "milestone-archives/v2" },
        "allowed_terminal_verdicts": {
          "const": ["accept", "reject", "inconclusive"]
        },
        "excluded_attempt_classes": {
          "const": ["invalid_run", "debug_run", "aborted_attempt", "failed_implementation_run"]
        },
        "retention": { "const": "no_automatic_deletion" }
      }
    }
  }
}
