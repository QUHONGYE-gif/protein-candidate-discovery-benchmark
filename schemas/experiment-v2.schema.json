{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QUHONGYE-gif/protein-candidate-discovery-benchmark/schemas/experiment-v2.schema.json",
  "title": "ProductionExperimentConfigV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_status",
    "experiment_id",
    "phase",
    "task_id",
    "dataset_manifest_sha256",
    "processing_manifest_sha256",
    "split_sha256",
    "models",
    "acquisitions",
    "seeds",
    "initial_sample_sizes",
    "batch_sizes",
    "budgets",
    "evaluation",
    "held_out_authorized"
  ],
  "properties": {
    "schema_version": { "const": "2" },
    "contract_status": { "const": "production" },
    "experiment_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "phase": { "enum": ["smoke", "development", "pilot", "frozen"] },
    "task_id": { "enum": ["alpha-amylase", "ired"] },
    "dataset_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "processing_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "split_sha256": { "$ref": "#/$defs/sha256" },
    "models": { "$ref": "#/$defs/uniqueStrings" },
    "acquisitions": { "$ref": "#/$defs/uniqueStrings" },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0 }
    },
    "initial_sample_sizes": { "$ref": "#/$defs/positiveIntegers" },
    "batch_sizes": { "$ref": "#/$defs/positiveIntegers" },
    "budgets": { "$ref": "#/$defs/positiveIntegers" },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_high_value_definition_id",
        "high_value_definitions",
        "metric_sets",
        "aggregation",
        "interpretation_policy",
        "access_boundary"
      ],
      "properties": {
        "primary_high_value_definition_id": { "const": "upper-tail-1pct" },
        "high_value_definitions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/highValueDefinition" },
                {
                  "properties": {
                    "definition_id": { "const": "upper-tail-1pct" },
                    "purpose": { "const": "primary" },
                    "value": { "const": 0.01 },
                    "derivation": {
                      "properties": {
                        "fraction": { "const": 0.01 }
                      }
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/highValueDefinition" },
                {
                  "properties": {
                    "definition_id": { "const": "upper-tail-0.5pct" },
                    "purpose": { "const": "sensitivity" },
                    "value": { "const": 0.005 },
                    "derivation": {
                      "properties": {
                        "fraction": { "const": 0.005 }
                      }
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/highValueDefinition" },
                {
                  "properties": {
                    "definition_id": { "const": "upper-tail-2pct" },
                    "purpose": { "const": "sensitivity" },
                    "value": { "const": 0.02 },
                    "derivation": {
                      "properties": {
                        "fraction": { "const": 0.02 }
                      }
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        },
        "metric_sets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["m2_static", "m3_m5_sequential", "task_seed_aggregates"],
          "properties": {
            "m2_static": {
              "const": [
                "spearman_rank_correlation",
                "high_value_recall_at_nominal_k"
              ]
            },
            "m3_m5_sequential": {
              "const": [
                "best_found_value",
                "simple_regret",
                "high_value_discovery_recall",
                "success_at_budget"
              ]
            },
            "task_seed_aggregates": {
              "const": ["success_probability"]
            }
          }
        },
        "aggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary_unit",
            "seed_role",
            "pooled_seed_primary",
            "raw_unitful_cross_task_aggregate",
            "cross_task_equal_weight_metric_ids"
          ],
          "properties": {
            "primary_unit": { "const": "task" },
            "seed_role": { "const": "within-task-algorithmic-randomness" },
            "pooled_seed_primary": { "const": false },
            "raw_unitful_cross_task_aggregate": { "const": false },
            "cross_task_equal_weight_metric_ids": {
              "const": [
                "spearman_rank_correlation",
                "high_value_recall_at_nominal_k",
                "high_value_discovery_recall",
                "success_probability"
              ]
            }
          }
        },
        "interpretation_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary_tie_expansion_fraction_limit",
            "sensitivity_fractions",
            "comparison_rule",
            "triggered_status"
          ],
          "properties": {
            "primary_tie_expansion_fraction_limit": { "const": 0.02 },
            "sensitivity_fractions": { "const": [0.005, 0.02] },
            "comparison_rule": { "const": "strict_sign_reversal" },
            "triggered_status": { "const": "fragile-inconclusive" }
          }
        },
        "access_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "prohibited_consumers"],
          "properties": {
            "owner": { "const": "evaluator-or-hidden-oracle" },
            "prohibited_consumers": {
              "const": [
                "candidate-features",
                "surrogate-model",
                "calibration",
                "acquisition-strategy"
              ]
            }
          }
        }
      }
    },
    "held_out_authorized": { "const": false }
  },
  "allOf": [
    {
      "if": {
        "properties": { "task_id": { "const": "alpha-amylase" } },
        "required": ["task_id"]
      },
      "then": {
        "properties": {
          "dataset_manifest_sha256": {
            "const": "c1679ca0d58c69f368b34974fbf43e9b23579892d0a7daef04bb1e354e1a1bac"
          },
          "processing_manifest_sha256": {
            "const": "cc0582a0c5f3a2d854c9c64c78b2995fd81d87e328241cd42121deee0ca2aaec"
          },
          "split_sha256": {
            "const": "c6b67b962b78656f8083b088909d801dd8c40c908333f310a4fc39cb86b3184a"
          },
          "evaluation": {
            "properties": {
              "high_value_definitions": {
                "prefixItems": [
                  {
                    "properties": {
                      "frozen_candidate_count": { "const": 2262 },
                      "derivation": {
                        "properties": { "nominal_k": { "const": 23 } }
                      }
                    }
                  },
                  {
                    "properties": {
                      "frozen_candidate_count": { "const": 2262 },
                      "derivation": {
                        "properties": { "nominal_k": { "const": 12 } }
                      }
                    }
                  },
                  {
                    "properties": {
                      "frozen_candidate_count": { "const": 2262 },
                      "derivation": {
                        "properties": { "nominal_k": { "const": 46 } }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "task_id": { "const": "ired" } },
        "required": ["task_id"]
      },
      "then": {
        "properties": {
          "dataset_manifest_sha256": {
            "const": "37938d62ec61c0ac912bfd49d690696d7b750f0a497558faf525a9b7d3e61643"
          },
          "processing_manifest_sha256": {
            "const": "929f0a46bfca015fb020bb7ebcc3a91e4de33922cd217399551b3dae1cc437ba"
          },
          "split_sha256": {
            "const": "9bff199ec81b9b5b1e0548c237b923b2ac7db1bf36382377ed36d30c042c725e"
          },
          "evaluation": {
            "properties": {
              "high_value_definitions": {
                "prefixItems": [
                  {
                    "properties": {
                      "frozen_candidate_count": { "const": 2070 },
                      "derivation": {
                        "properties": { "nominal_k": { "const": 21 } }
                      }
                    }
                  },
                  {
                    "properties": {
                      "frozen_candidate_count": { "const": 2070 },
                      "derivation": {
                        "properties": { "nominal_k": { "const": 11 } }
                      }
                    }
                  },
                  {
                    "properties": {
                      "frozen_candidate_count": { "const": 2070 },
                      "derivation": {
                        "properties": { "nominal_k": { "const": 42 } }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "positiveIntegers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "highValueDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_id",
        "purpose",
        "kind",
        "value",
        "candidate_role",
        "frozen_candidate_count",
        "ranking_policy",
        "reporting_policy",
        "derivation"
      ],
      "properties": {
        "definition_id": { "type": "string" },
        "purpose": { "enum": ["primary", "sensitivity"] },
        "kind": { "const": "quantile" },
        "value": { "enum": [0.005, 0.01, 0.02] },
        "candidate_role": { "const": "candidate-pool" },
        "frozen_candidate_count": { "enum": [2262, 2070] },
        "ranking_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label_direction",
            "secondary_order",
            "boundary_tie_policy",
            "non_finite_policy",
            "duplicate_candidate_id_policy"
          ],
          "properties": {
            "label_direction": { "const": "higher_is_better" },
            "secondary_order": { "const": "candidate_id_ascending" },
            "boundary_tie_policy": { "const": "include_all_equal" },
            "non_finite_policy": { "const": "error" },
            "duplicate_candidate_id_policy": { "const": "error" }
          }
        },
        "reporting_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_outputs"],
          "properties": {
            "required_outputs": {
              "const": [
                "nominal_k",
                "actual_high_value_count",
                "boundary_score",
                "boundary_tie_count"
              ]
            }
          }
        },
        "derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fraction", "rounding", "nominal_k"],
          "properties": {
            "fraction": { "enum": [0.005, 0.01, 0.02] },
            "rounding": { "const": "ceil" },
            "nominal_k": { "enum": [11, 12, 21, 23, 42, 46] }
          }
        }
      }
    }
  }
}
